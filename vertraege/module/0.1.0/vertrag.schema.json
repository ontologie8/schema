{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontologie8:vertrag:module:0.1.0",
  "title": "Module, Profile, Pakete und Übernahmen",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "oneOf": [{"$ref": "#/$defs/modul"}, {"$ref": "#/$defs/profil"}, {"$ref": "#/$defs/paket"}, {"$ref": "#/$defs/uebernahme"}],
  "$defs": {
    "iri": {"$ref": "urn:ontologie8:schema:kern:0.1.0#/$defs/iri"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "texte": {"type": "array", "minItems": 1, "items": {"$ref": "urn:ontologie8:schema:kern:0.1.0#/$defs/text"}},
    "iris": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/iri"}},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bindung": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/iri"}, "version": {"$ref": "#/$defs/version"}}
    },
    "manifestverweis": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "artefakt_id"],
      "properties": {"id": {"$ref": "#/$defs/iri"}, "version": {"$ref": "#/$defs/version"}, "artefakt_id": {"$ref": "#/$defs/iri"}}
    },
    "begriff": {
      "type": "object", "additionalProperties": false, "required": ["id", "art", "definitionen"],
      "properties": {"id": {"$ref": "#/$defs/iri"}, "art": {"enum": ["entitaet", "aussage", "schema", "abbildung"]}, "definitionen": {"$ref": "#/$defs/texte"}}
    },
    "artefakt": {
      "type": "object", "additionalProperties": false, "required": ["id", "pfad", "art", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/iri"}, "pfad": {"type": "string", "minLength": 1}, "art": {"enum": ["json", "text"]}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "modul": {
      "type": "object", "additionalProperties": false,
      "required": ["art", "id", "version", "vertrag_version", "bezeichnungen", "abhaengigkeiten", "bereitstellungen", "nutzungen", "artefakt_ids"],
      "properties": {
        "art": {"const": "modul"}, "id": {"$ref": "#/$defs/iri"}, "version": {"$ref": "#/$defs/version"}, "vertrag_version": {"const": "0.1.0"},
        "bezeichnungen": {"$ref": "#/$defs/texte"}, "abhaengigkeiten": {"type": "array", "items": {"$ref": "#/$defs/bindung"}},
        "bereitstellungen": {"type": "array", "items": {"$ref": "#/$defs/begriff"}}, "nutzungen": {"$ref": "#/$defs/iris"}, "artefakt_ids": {"$ref": "#/$defs/iris"}
      }
    },
    "profil": {
      "type": "object", "additionalProperties": false,
      "required": ["art", "id", "version", "vertrag_version", "bezeichnungen", "module", "schema_id", "abbildung_id", "erwartungsvertrag_id", "entitaetstypen", "aussagetypen", "beispiel_id", "erwartungen_id"],
      "properties": {
        "art": {"const": "profil"}, "id": {"$ref": "#/$defs/iri"}, "version": {"$ref": "#/$defs/version"}, "vertrag_version": {"const": "0.1.0"},
        "bezeichnungen": {"$ref": "#/$defs/texte"}, "module": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bindung"}},
        "schema_id": {"$ref": "#/$defs/iri"}, "abbildung_id": {"$ref": "#/$defs/iri"}, "erwartungsvertrag_id": {"$ref": "#/$defs/iri"},
        "entitaetstypen": {"$ref": "#/$defs/iris"}, "aussagetypen": {"$ref": "#/$defs/iris"}, "beispiel_id": {"$ref": "#/$defs/iri"}, "erwartungen_id": {"$ref": "#/$defs/iri"}
      }
    },
    "paket": {
      "type": "object", "additionalProperties": false,
      "required": ["art", "id", "version", "vertrag_version", "status", "module", "profile", "artefakte"],
      "properties": {
        "art": {"const": "paket"}, "id": {"$ref": "#/$defs/iri"}, "version": {"$ref": "#/$defs/version"}, "vertrag_version": {"const": "0.1.0"},
        "status": {"const": "entwicklungsstand"},
        "module": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manifestverweis"}},
        "profile": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manifestverweis"}},
        "artefakte": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artefakt"}}
      }
    },
    "uebernahme": {
      "type": "object", "additionalProperties": false,
      "required": ["art", "vertrag_version", "paket_id", "paket_version", "paketpfad", "paket_sha256", "speicherziel"],
      "properties": {
        "art": {"const": "uebernahme"}, "vertrag_version": {"const": "0.1.0"},
        "paket_id": {"$ref": "#/$defs/iri"}, "paket_version": {"$ref": "#/$defs/version"}, "paketpfad": {"type": "string", "minLength": 1}, "paket_sha256": {"$ref": "#/$defs/sha256"},
        "speicherziel": {"enum": ["github", "sharepoint", "s3"]}
      }
    }
  }
}
